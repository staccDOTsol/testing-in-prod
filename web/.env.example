# Mainnet RPC used only for ENS name resolution (forward + reverse).
# Defaults to a public endpoint if unset — bring your own for production traffic.
VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Lit Protocol network to connect to. One of: datil-dev, datil-test, datil.
VITE_LIT_NETWORK=datil-dev
